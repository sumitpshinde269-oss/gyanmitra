# GyanMitra server environment variables
# Copy to server/.env and adjust values as needed.
# Do not commit real secrets.

# HTTP port for the Express API (default: 5000)
PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/gyanmitra
# If MongoDB is unavailable, the server falls back to in-memory MongoDB, then JSON file storage.
MONGODB_URI=mongodb://localhost:27017/gyanmitra

# Secret used to sign JWT auth tokens (change in production)
JWT_SECRET=change_me_to_a_long_random_string

# Shared password for auto-seeded demo accounts: coordinator, tutor1, parent1
DEMO_PASSWORD=password123
